# ID Spreadsheet (ambil dari URL: /d/<INI>/edit)
SPREADSHEET_ID=ISI_DENGAN_ID_SPREADSHEET_ANDA

# Isi SELURUH file JSON service account (satu baris)
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"...@....iam.gserviceaccount.com"}

# Kunci session (acak, min. 32 karakter)
SESSION_SECRET=ganti_dengan_string_acak_panjang

NEXT_PUBLIC_APP_NAME=Sistem Absensi Digital
